Content-Type: application/json

{
    "ID": "11111111-1111-1111-1111-111111111111",
    "Name": "Shyam",
    "EmpEmail": "shyam@gmail.com",
    "Age": 25,
    "CompanyAddress": "Bangalore",
    "MobileNumber": "9876543210",
    "Salary": 50000.00,
    "Number": "EMP001",
    "RAm": "Developer"
}


