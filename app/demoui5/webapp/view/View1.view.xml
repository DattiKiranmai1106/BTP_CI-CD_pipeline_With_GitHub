<mvc:View
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
	xmlns:smartTable="sap.ui.comp.smarttable"
	controllerName="com.sap.demo.demoui5.controller.View1"
	height="100%">

		<!-- use this to make the table occupy the available screen height -->
		<!-- <VBox fitContainer="true"> -->
			<smartFilterBar:SmartFilterBar id="smartFilterBar" entitySet="EmployeeDetails" basicSearchFieldName="EmployeeID" enableBasicSearch="true" showFilterConfiguration="false" >
				<smartFilterBar:controlConfiguration>
					<smartFilterBar:ControlConfiguration key="EmployeeID" visibleInAdvancedArea="true">
					<!-- <smartFilterBar:defaultFilterValues>
							<smartFilterBar:SelectOption low="1">
							</smartFilterBar:SelectOption>
						</smartFilterBar:defaultFilterValues> -->
					</smartFilterBar:ControlConfiguration>
                    <smartFilterBar:ControlConfiguration key="Address" visibleInAdvancedArea="true">
					<!-- <smartFilterBar:defaultFilterValues>
							<smartFilterBar:SelectOption low="1">
							</smartFilterBar:SelectOption>
						</smartFilterBar:defaultFilterValues> -->
					</smartFilterBar:ControlConfiguration>
				</smartFilterBar:controlConfiguration>
                
				
			</smartFilterBar:SmartFilterBar>

			<smartTable:SmartTable id="LineItemsSmartTable" 
            entitySet="EmployeeDetails" 
            smartFilterId="smartFilterBar"
            tableType="ResponsiveTable" 
            enableExport="true" 
            beforeExport=".onBeforeExport" 
            useVariantManagement="true" 
            useTablePersonalisation="true" 
            header="Employee Details" 
            showRowCount="true" 
            persistencyKey="SmartTableAnalytical_Explored" 
            enableAutoBinding="true" 
            class="sapUiResponsiveContentPadding" 
            initiallyVisibleFields="EmployeeID,Address,City,Pincode"
            enableAutoColumnWidth="true" editTogglable="true" >
            <smartTable:customToolbar>
					<OverflowToolbar>
						<ToolbarSpacer />
						<ToolbarSeparator />
						<Button icon="sap-icon://company-view" tooltip="{i18n>msaAddButToolTip}" press="onAddMsaDetails" />
						<ToolbarSeparator />
						<Button icon="sap-icon://customer" tooltip="{i18n>addCustTooltip}" press="onpressManagedCustomer" />
						<ToolbarSeparator />
					</OverflowToolbar>
				</smartTable:customToolbar>
				<Table >
					<columns></columns>
					<items>
						<ColumnListItem type="Navigation" press="OnPressNavigationMsaDet"></ColumnListItem>
					</items>
				</Table>
				<!-- layout data used to make the table growing but the filter bar fixed -->
				<smartTable:layoutData>
					<FlexItemData growFactor="1" baseSize="0%"/>
				</smartTable:layoutData>
			</smartTable:SmartTable>
		<!-- </VBox> -->
</mvc:View>